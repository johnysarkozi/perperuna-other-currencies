# Shopify backends — one custom app per store, credentials from the Dev Dashboard.
#
# NEVER commit real values. In Claude Code on the web these go into the cloud
# environment's Environment variables (personal environment, not a shared org
# one); in CI they go into repo Actions secrets. A local .env is gitignored and
# is not read by cloud sessions.
#
# Backends enabled in this environment:
SHOPIFY_SHOPS=sk,cz,ro,pl,hu

# Per backend: SHOPIFY_<KEY>_SHOP / _CLIENT_ID / _CLIENT_SECRET
SHOPIFY_CZ_SHOP=perperuna-cz.myshopify.com
SHOPIFY_CZ_CLIENT_ID=
SHOPIFY_CZ_CLIENT_SECRET=

SHOPIFY_RO_SHOP=perperuna-ro.myshopify.com
SHOPIFY_RO_CLIENT_ID=
SHOPIFY_RO_CLIENT_SECRET=

SHOPIFY_PL_SHOP=perperuna-pl.myshopify.com
SHOPIFY_PL_CLIENT_ID=
SHOPIFY_PL_CLIENT_SECRET=

SHOPIFY_HU_SHOP=perperuna-hu.myshopify.com
SHOPIFY_HU_CLIENT_ID=
SHOPIFY_HU_CLIENT_SECRET=

SHOPIFY_SK_SHOP=perperuna-store.myshopify.com
SHOPIFY_SK_CLIENT_ID=
SHOPIFY_SK_CLIENT_SECRET=

# OpenAI (ChatGPT) ads measurement pixel — ID z Ads Manageru, karta Conversions.
# Nie je to heslo, ale drží sa rovnakého režimu ako ostatné: v repe nikde nie je.
OPENAI_PIXEL_ID_CZ=
